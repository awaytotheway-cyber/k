# ---------------------------------------------------------------------------
# TrueROAS environment
#
# Copy to .env and fill in. Nothing in this file is secret; .env itself is
# gitignored. See README.md for where each value comes from.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Local dev: the Postgres running on this machine.
# Production: a Neon connection string (use the POOLED url for the app).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/trueroas?schema=public"

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# The app's own origin. Used for callbacks, pixel snippet, and share links.
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Salt for hashing visitor IP addresses. Raw IPs are never stored, and rotating
# this value deliberately breaks the link between old and new hashes.
# Generate with: openssl rand -hex 32
IP_HASH_SALT=""

# --- AI (Anthropic) -------------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
# Nightly Daily Action Brief + generated ad concepts: quality matters, runs once.
AI_MODEL_BRIEF="claude-opus-5"
# Chat and angle tagging: higher volume, lower cost.
AI_MODEL_CHAT="claude-sonnet-5-5"

# --- Stripe: our own billing ---------------------------------------------
# Test mode keys while developing. https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Price ids for the three tiers (create them in Stripe, test mode first).
STRIPE_PRICE_STARTER_MONTHLY=""
STRIPE_PRICE_STARTER_ANNUAL=""
STRIPE_PRICE_GROWTH_MONTHLY=""
STRIPE_PRICE_GROWTH_ANNUAL=""
STRIPE_PRICE_AGENCY_MONTHLY=""
STRIPE_PRICE_AGENCY_ANNUAL=""

# --- Email (transactional) ------------------------------------------------
# Resend: https://resend.com/api-keys. Leave blank to log emails to the console.
RESEND_API_KEY=""
EMAIL_FROM="TrueROAS <noreply@example.com>"

# --- Cron ----------------------------------------------------------------
# Shared secret so only the scheduler can invoke /api/cron/*.
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# --- Ad platforms (Phase 3 — leave blank until app review clears) ---------
META_APP_ID=""
META_APP_SECRET=""
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_DEVELOPER_TOKEN=""

# Optional: connection pool size per process (default 5).
DATABASE_POOL_MAX="5"
